# Copy to a local .env for `netlify dev`, and set the same variables in
# Netlify's Site settings > Environment variables for the deployed site.
# Never commit a real .env file.

# MongoDB Atlas connection string (Atlas dashboard > Connect > Drivers).
# Use a database user scoped to just this database, not your Atlas admin.
MONGODB_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/?retryWrites=true&w=majority

# Database name (any name you like — created automatically on first write).
MONGODB_DB=cowboychurch

# Long random string used to sign staff session tokens. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=replace-with-a-long-random-string
